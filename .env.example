# ---------------------------------------------------------------------------
# Metrx — environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- BOT Chain Mainnet ------------------------------------------------------
BOT_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_ID=677
BOT_EXPLORER_URL=https://scan.botchain.ai
BOT_EXPLORER_API=https://scan.botchain.ai/api
SCAN_API_KEY=

# --- Keys (generate with `pnpm keys:generate`) ------------------------------
# Deployer broadcasts MetrxCore and pays gas. Fund with native BOT.
DEPLOYER_PRIVATE_KEY=
# AI verifier signs EIP-712 AIVerdict certificates. Needs NO balance.
AI_VERIFIER_PRIVATE_KEY=
AI_VERIFIER_ADDRESS=
# Operator used by the scripted mainnet proof runs. Funded from the deployer.
DEMO_OPERATOR_PRIVATE_KEY=
DEMO_OPERATOR_ADDRESS=

# --- Deployed contract ------------------------------------------------------
METRX_CORE_ADDRESS=

# --- AI verifier model ------------------------------------------------------
# groq | anthropic | openai | workers-ai | mock
# groq + openai/gpt-oss-120b enforces the verdict schema at the model, which removes the
# malformed-response failure mode entirely. Free tier returns 429 with retry-after; the
# verifier honours it and refuses to sign rather than guessing an outcome.
AI_PROVIDER=groq
AI_MODEL_ID=openai/gpt-oss-120b
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Web app (Vite, inlined into the bundle at build time) ------------------
VITE_METRX_CORE_ADDRESS=
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_BOT_RPC_URL=https://rpc.botchain.ai
VITE_AI_VERIFIER_ADDRESS=
# Left empty hides the source link rather than shipping a dead one.
VITE_GITHUB_URL=https://github.com/winsznx/metrx
VITE_DEMO_VIDEO_URL=
